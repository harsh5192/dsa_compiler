# Copy to .env and edit, or export these before starting the server.
# Nothing here is required for a laptop install; every value has a default.

# --- core -------------------------------------------------------------------
# Pin the secret to keep sessions alive across restarts. Leave empty and a
# random key is generated per process (sign-ins end on restart).
DSA_SECRET_KEY=
DSA_DEBUG=1
DSA_PLATFORM_NAME=DSA Studio
DSA_PLATFORM_TAGLINE=Sheets, code and progress, offline.
DSA_TIME_ZONE=UTC

# --- web --------------------------------------------------------------------
DSA_ALLOWED_HOSTS=localhost,127.0.0.1,[::1],0.0.0.0
DSA_CSRF_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
# Set to 1 when serving over TLS (secure cookies + HSTS + no DEBUG).
DSA_HTTPS=0
DSA_HSTS_SECONDS=0

# --- database ---------------------------------------------------------------
# sqlite (default) or postgresql
DSA_DB_ENGINE=sqlite
DSA_DB_PATH=db.sqlite3
DSA_DB_NAME=
DSA_DB_USER=
DSA_DB_PASSWORD=
DSA_DB_HOST=127.0.0.1
DSA_DB_PORT=5432

# --- code execution ---------------------------------------------------------
# "subprocess" (default, no extra dependencies) or "docker" (stronger isolation)
DSA_EXECUTION_BACKEND=subprocess
DSA_DOCKER_IMAGE=python:3.12-slim
DSA_TIME_LIMIT=5
DSA_BATCH_TIME_LIMIT=30
DSA_MEMORY_LIMIT_MB=512
DSA_OUTPUT_LIMIT=65536
DSA_WORK_DIR=media/exec
# Refuse to let submitted code open outbound network connections.
DSA_DISABLE_NETWORK=0

# --- editor -----------------------------------------------------------------
DSA_EDITORS=monaco,plain
DSA_DEFAULT_EDITOR=monaco
